+/*!
+    \qmlproperty bool WebEngineView::backgroundThrottling
+    \since 6.140
+
+    Whether the page is throttled like a background tab while the view is hidden, as
+    Electron's \c backgroundThrottling web preference.
+
+    When \c false, a hidden page keeps running as a shown one does: its timers run at
+    full rate and \c document.visibilityState reports \c visible. The property can be
+    changed at any time.
+
+    The default value is \c true.
+*/
+bool QQuickWebEngineView::backgroundThrottling() const
+{
+    const Q_D(QQuickWebEngineView);
+    return d->m_backgroundThrottling;
+}
+
+void QQuickWebEngineView::setBackgroundThrottling(bool enabled)
+{
+    Q_D(QQuickWebEngineView);
+    if (d->m_backgroundThrottling == enabled)
+        return;
+    d->m_backgroundThrottling = enabled;
+    // Before initialization, initializationFinished() applies it.
+    d->adapter->setBackgroundThrottling(enabled);
+    Q_EMIT backgroundThrottlingChanged();
+}
+
 bool QQuickWebEngineView::recentlyAudible() const
 {
     const Q_D(QQuickWebEngineView);
