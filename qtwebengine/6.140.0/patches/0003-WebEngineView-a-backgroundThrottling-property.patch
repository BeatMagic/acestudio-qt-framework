diff --git a/src/core/render_widget_host_view_qt.cpp b/src/core/render_widget_host_view_qt.cpp
index cb77820..50b937b 100644
--- a/src/core/render_widget_host_view_qt.cpp
+++ b/src/core/render_widget_host_view_qt.cpp
@@ -855,12 +855,30 @@ void RenderWidgetHostViewQt::notifyHidden()
 {
     if (!m_visible)
         return;
+    // As Electron's RenderWidgetHostViewAura::HideImpl: a widget that background throttling
+    // is disabled for stays shown, and keeps producing frames.
+    if (host()->disable_hidden_)
+        return;
     m_visible = false;
     host()->WasHidden();
     m_delegatedFrameHost->WasHidden(content::DelegatedFrameHost::HiddenCause::kOther);
     m_delegatedFrameHost->DetachFromCompositor();
 }
 
+// As Electron's WebContents::SetBackgroundThrottling: show a widget that is hidden when
+// throttling is disabled, and hide one that was kept shown when it is allowed again while
+// the view is hidden.
+void RenderWidgetHostViewQt::setBackgroundThrottling(bool allowed)
+{
+    host()->disable_hidden_ = !allowed;
+    if (!m_delegate)
+        return;
+    if (!allowed)
+        notifyShown();
+    else if (!m_delegate->isVisible())
+        notifyHidden();
+}
