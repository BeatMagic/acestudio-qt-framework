@@ -2212,6 +2216,49 @@ void WebContentsAdapter::setVisible(bool visible)
     updateRecommendedState();
 }
 
+// Electron's webPreferences backgroundThrottling, after its WebContents::SetBackgroundThrottling
+// and HandleNewRenderFrame: while throttling is disallowed, every widget of the page is kept
+// from being hidden, and every page in its frame tree treats a hidden page as a shown one.
+static void applyBackgroundThrottling(content::RenderFrameHost *frame, bool allowed)
+{
+    if (auto *view = frame->GetView())
+        static_cast<content::RenderWidgetHostImpl *>(view->GetRenderWidgetHost())->disable_hidden_ = !allowed;
+    frame->GetRenderViewHost()->SetSchedulerThrottling(allowed);
+}
+
+void WebContentsAdapter::setBackgroundThrottling(bool allowed)
+{
+    m_backgroundThrottling = allowed;
+    CHECK_INITIALIZED();
+
+    // Every local root (cross-process frame) has its own widget and RenderView; inner
+    // WebContents (guests) keep their own setting.
+    m_webContents->GetPrimaryMainFrame()->ForEachRenderFrameHostWithAction(
+            [this, allowed](content::RenderFrameHost *frame) {
+                if (content::WebContents::FromRenderFrameHost(frame) != m_webContents.get())
+                    return content::RenderFrameHost::FrameIterationAction::kSkipChildren;
+                applyBackgroundThrottling(frame, allowed);
+                return content::RenderFrameHost::FrameIterationAction::kContinue;
+            });
+    if (auto *rwhv = static_cast<RenderWidgetHostViewQt *>(m_webContents->GetRenderWidgetHostView()))
+        rwhv->setBackgroundThrottling(allowed);
+    updateRecommendedState();
+}
+
+void WebContentsAdapter::backgroundThrottlingFrameCreated(content::RenderFrameHost *frame)
+{
+    if (!m_backgroundThrottling)
+        applyBackgroundThrottling(frame, false);
+}
+
+void WebContentsAdapter::backgroundThrottlingViewChanged()
+{
+    if (m_backgroundThrottling)
+        return;
+    if (auto *rwhv = static_cast<RenderWidgetHostViewQt *>(m_webContents->GetRenderWidgetHostView()))
+        rwhv->setBackgroundThrottling(false);
+}
+
 void WebContentsAdapter::freeze()
 {
     m_webContents->SetPageFrozen(true);
