SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
(the license of the qtdeclarative files this patch modifies)
---
 src/quicktemplates/qquickpopupwindow.cpp | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/quicktemplates/qquickpopupwindow.cpp b/src/quicktemplates/qquickpopupwindow.cpp
index 4d3bc71..ac29df2 100644
--- a/src/quicktemplates/qquickpopupwindow.cpp
+++ b/src/quicktemplates/qquickpopupwindow.cpp
@@ -313,7 +313,18 @@ bool QQuickPopupWindowPrivate::filterPopupSpecialCases(QEvent *event)
             // to the window under the pointer, and therefore also to the MenuBar.
             // The latter would otherwise cause a menu to reopen again immediately, and
             // undermine that we want to close all popups.
-            closePopups(QQuickPopup::CloseOnPressOutside | QQuickPopup::CloseOnPressOutsideParent);
+            // Don't use closePopups() here: it keeps a CloseOnPressOutsideParent popup open
+            // while the press is inside its parent item, and a menu bar menu has that policy
+            // with its MenuBarItem as parent item. Pressing the item of an open menu would
+            // then leave the menu open, with the press swallowed.
+            QQuickPopup *current = q->popup();
+            while (current && QQuickPopupPrivate::get(current)->popupWindow) {
+                qCDebug(lcPopupWindow) << "Closing" << current << "from a pointer press on the menu bar.";
+                current->close();
+                auto *transientParentPopupWindow = qobject_cast<QQuickPopupWindow *>(
+                        QQuickPopupPrivate::get(current)->popupWindow->transientParent());
+                current = transientParentPopupWindow ? transientParentPopupWindow->popup() : nullptr;
+            }
             return true;
         } else if (!targetPopup) {
             // Pressed outside either a popup window, or a menu or menubar that owns a menu using popup windows.
